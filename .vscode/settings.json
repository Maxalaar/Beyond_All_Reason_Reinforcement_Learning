{
    // Trainings run in the conda environment of Maxalaar_Reinforcement_Learning, where this package, the environment
    // (Beyond_All_Reason_Environment) and the library are installed with pip install -e.
    "python.defaultInterpreterPath": "/media/SSD_1To/conda/envs/Maxalaar_Reinforcement_Learning/bin/python",
    "python.terminal.activateEnvironment": true,
    "[python]": {
        "editor.defaultFormatter": "charliermarsh.ruff",
        "editor.formatOnSave": true
    },
    "editor.rulers": [120],
    "python.testing.pytestEnabled": true,
    "python.testing.pytestArgs": ["tests"],
    "files.watcherExclude": {"**/experiments/**": true},
    "search.exclude": {"experiments": true}
}
